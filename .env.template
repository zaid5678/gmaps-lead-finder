# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit it.
#
# HOW TO GET A GMAIL APP PASSWORD:
#   1. Go to myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already on)
#   3. Search for "App passwords" in the search bar
#   4. Select app: Mail  |  device: Other  |  name it "lead-finder"
#   5. Copy the 16-character password (spaces are fine: "wsgj nmyg lrlf cnnr")

GMAIL_EMAIL=zfkhan321@gmail.com
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# MULTI-ACCOUNT SENDING (optional — add extra Gmail accounts to send more per day)
# Each account sends up to 400 emails/day safely. Format: email1:password1,email2:password2
# GMAIL_ACCOUNTS=second@gmail.com:xxxx xxxx xxxx xxxx,third@gmail.com:xxxx xxxx xxxx xxxx

# COMPANIES HOUSE API (free — register at https://developer.company-information.service.gov.uk/)
# Once registered, create an API key (REST API) and paste it below.
# COMPANIES_HOUSE_API_KEY=your_api_key_here

# Optional tuning (these are already the defaults — override here if needed)
DELAY_BETWEEN_EMAILS=60
